[Unit]
Description=Python Lane (Gated Modules) - CIPSE Lab
After=network.target
Wants=network.target

[Service]
Type=simple
User=python_user
Group=python_user
WorkingDirectory=/opt/cipse-lab/apps/python-lane
Environment=PYTHON_LANE_SECRET=REPLACE_WITH_SECRET_FROM_ENV_FILE
ExecStart=/opt/cipse-lab/apps/python-lane/.venv/bin/python -m uvicorn app:app --uds /lab/ipc/python-lane.sock
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
ReadWritePaths=/lab/sandbox /lab/runs /lab/ipc
ReadOnlyPaths=/opt/cipse-lab
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=1024
LimitNPROC=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
