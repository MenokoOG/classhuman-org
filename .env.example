# Copy to a local .env — NEVER commit real values.
# Frontend (Vite) vars are PUBLIC once built. Do NOT put secrets here.
# Real secrets (e.g. OpenAI key) live in the Netlify dashboard and are used
# only by serverless functions, never the browser bundle.
VITE_SITE_URL=http://classhuman.org

# --- Server-side only (Netlify env / functions) — NOT exposed to the browser ---
# Banshee site agent (netlify/functions/banshee.mjs).
# Set these in the Netlify dashboard, never in a committed file.
#   OPENAI_API_KEY   Required for Banshee live mode. Absent → deterministic
#                    offline mode (Banshee still answers from site content).
#   BANSHEE_MODEL    Optional. OpenAI model id. Default: gpt-4o-mini.
# OPENAI_API_KEY=sk-...
# BANSHEE_MODEL=gpt-4o-mini
