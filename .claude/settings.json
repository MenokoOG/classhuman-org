{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read", "Write", "Edit", "Grep", "Glob",
      "Bash(npm run build)", "Bash(npm run dev)", "Bash(npm install*)",
      "Bash(npm run lint*)", "Bash(git status)", "Bash(git diff*)"
    ],
    "deny": [
      "Read(env.txt)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
